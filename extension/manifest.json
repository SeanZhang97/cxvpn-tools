{
  "manifest_version": 3,
  "name": "CX Toolkit 网页快开",
  "version": "1.1.1",
  "description": "在 CX Toolkit 中打开自动登录条目时，由本扩展在 Edge 中完成登录；没有待领取任务时不做任何操作。",
  "key": "",
  "permissions": ["nativeMessaging", "alarms"],
  "host_permissions": ["https://10.0.34.53/*", "http://192.168.1.51/*", "https://10.0.26.27/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "CX Toolkit 网页快开",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://10.0.34.53/*", "http://192.168.1.51/*", "https://10.0.26.27/*"],
      "js": ["platforms/ifort.js", "platforms/jumpserver.js", "platforms/gitlab.js", "content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ]
}
